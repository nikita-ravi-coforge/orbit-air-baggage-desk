{
    "permissions": {
      "deny": [
        "Read(./.env)",
        "Read(./.env.*)"
      ]
    },
    "hooks": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": ".venv/bin/pytest -q 1>&2; rc=$?; if [ $rc -ne 0 ] && [ $rc -ne 5 ]; then exit 2; fi"
            }
          ]
        }
      ]
    }
  }